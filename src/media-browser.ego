// Executed inside the installed Ego Lite CLI. Only read the signed-in creator's pages.
const homes = {
  douyin: "https://creator.douyin.com/creator-micro/content/manage",
  xhs: "https://creator.xiaohongshu.com/new/note-manager",
  kuaishou: "https://cp.kuaishou.com/article/manage/video",
  bilibili: "https://member.bilibili.com/platform/upload-manager/article",
};
const lists = { douyin: "[class*=video-card-info]", xhs: ".note-card" };
const fansPages = {
  douyin: homes.douyin,
  xhs: "https://creator.xiaohongshu.com/statistics/fans-data",
  kuaishou: "https://cp.kuaishou.com/profile",
  bilibili: "https://member.bilibili.com/platform/home",
};
const ksAnalysis = "https://cp.kuaishou.com/statistics/article";

async function go(page, url) {
  if ((await page.url()).split(/[?#]/)[0] !== url)
    await page.goto(url, { waitUntil: "commit", timeout: 25000 });
}
async function ensureReady(page, check, arg) {
  try {
    await page.waitForFunction(check, arg, { timeout: 18000 });
  } catch {
    const state = await page.evaluate(() => {
      const text = document.body?.innerText.trim() || "";
      if (/扫码登录|验证码登录|登录过期|请先登录|安全验证|请完成验证|完成下列验证|验证后继续|访问验证/.test(document.title + " " + text) ||
          /passport|\/login\b/.test(location.hostname + location.pathname))
        return "需在 Ego Lite 登录或完成人工验证";
      const code = text.match(/(?:ERR_[A-Z_]+|HTTP ERROR \d{3})/)?.[0];
      if (code) return "后台页面未返回预期数据（" + code + "）";
      if (!text) return "后台页面未返回预期数据，页面仍为空白";
      return "后台页面未返回预期数据（" + (document.title || "创作者后台") + "），可稍后重试";
    }).catch(() => "后台页面未返回预期数据，可稍后重试");
    throw new Error(state);
  }
}
async function identity(page, platform, expectedId) {
  const address = new URL(await page.url());
  if (address.origin !== new URL(homes[platform]).origin || /\/login\b|\/passport\b/.test(address.pathname)) {
    throw new Error("Sign in to the creator platform in this Ego Lite profile.");
  }
  const a = await page.evaluate(async (p) => {
    if (p === "xhs") {
      const u =
        document.querySelector("#app")?.__vue_app__?.config.globalProperties.$store.state.Auth.userInfo;
      return { id: u?.userId, name: u?.userName };
    }
    if (p === "douyin") {
      const u = (await (await fetch("/web/api/media/user/info/")).json()).user;
      return { id: u?.uid, name: u?.nickname, total: u?.follower_count };
    }
    if (p === "kuaishou") {
      const r = await (
        await fetch("/rest/cp/creator/pc/home/userInfo", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: "{}",
        })
      ).json();
      const u = r.data?.coreUserInfo;
      return { id: u?.userId, name: u?.userName, total: u?.fansNum };
    }
    const u = (
      await (await fetch("https://api.bilibili.com/x/web-interface/nav", { credentials: "include" })).json()
    ).data;
    return u?.isLogin ? { id: u.mid, name: u.uname } : null;
  }, platform);
  if (!a?.id) throw new Error("未读到当前账号，请检查 Ego Lite 的平台登录状态");
  if (expectedId && String(a.id) !== expectedId)
    throw new Error("Ego Lite 登录的账号与绑定账号不符，请核对后重试");
  return { ...a, id: String(a.id), name: a.name || String(a.id) };
}

// The creator dashboard shows cumulative metrics; a missing field is not a zero.
function readCards({ platform, offset, selector }) {
  const visible = [...document.querySelectorAll(selector)].filter((n) => n.getClientRects().length);
  const all =
    platform === "xhs"
      ? [
          ...new Map(
            visible.map((n) => [
              JSON.parse(n.getAttribute("data-impression") || "{}").noteTarget?.value?.noteId,
              n,
            ])
          ).values(),
        ]
      : visible;
  const text = document.body.innerText;
  const num = (v) => {
    if (v == null || v === "") return undefined;
    const m = String(v)
      .replaceAll(",", "")
      .trim()
      .match(/^(-?\d+(?:\.\d+)?)\s*([万亿kKmM]?)$/);
    return m
      ? Math.round(Number(m[1]) * ({ 万: 10000, 亿: 1e8, k: 1000, m: 1e6 }[m[2].toLowerCase()] || 1))
      : undefined;
  };
  const date = (v) => {
    const d = new Date(v);
    return Number.isFinite(d.valueOf())
      ? d.toLocaleDateString("sv-SE", { timeZone: "Asia/Shanghai" }) +
          " " +
          d.toLocaleTimeString("en-GB", { timeZone: "Asia/Shanghai" })
      : "";
  };
  const clean = (o) => Object.fromEntries(Object.entries(o).filter(([, v]) => v !== undefined && v !== null));
  const douyinStatus = (node) => {
    const card = node.closest('[class*="video-card-content"]')?.parentElement || node;
    const status = card.querySelector('[class*="info-status"]')?.innerText ?? card.innerText;
    return status.split(/\r?\n/).map(line => line.trim()).find(line => line === "已发布" || line === "流量减少");
  };
  const posts = [];
  for (const node of all.slice(offset)) {
    let id,
      title,
      published,
      counts,
      detail = {};
    if (platform === "douyin") {
      const status = douyinStatus(node);
      if (!status) continue;
      if (status === "流量减少") detail["发布状态"] = status;
      let f = node[Object.keys(node).find((k) => k.startsWith("__reactFiber"))],
        v;
      for (let i = 0; i < 35 && f; i++, f = f.return) {
        v = Object.values(f.memoizedProps || {}).find(
          (o) => o && typeof o === "object" && o.aweme_id && o.desc !== undefined
        );
        if (v) break;
      }
      if (!v) throw new Error("抖音已发布卡片缺少作品标识");
      id = v.aweme_id;
      title = v.item_title || v.desc || v.caption;
      published = date(Number(v.create_time) * 1000);
      const s = v.statistics || {};
      counts = clean({
        views: num(s.play_count),
        likes: num(s.digg_count),
        comments: num(s.comment_count),
        favorites: num(s.collect_count),
        shares: num(s.share_count),
      });
      const m = v.metrics || {};
      for (const [key, label] of Object.entries({
        completion_rate: "完播率",
        completion_rate_5s: "5 秒完播率",
        bounce_rate_2s: "2 秒跳出率",
        avg_view_proportion: "平均播放占比",
        fan_view_proportion: "粉丝播放占比",
      })) {
        if (m[key] != null && m[key] !== "" && Number.isFinite(+m[key]))
          detail[label] = Number((+m[key] * 100).toFixed(2)) + "%";
      }
      if (m.avg_view_second != null && Number.isFinite(+m.avg_view_second))
        detail["平均观看时长"] = Number((+m.avg_view_second).toFixed(2)) + " 秒";
      if (num(m.subscribe_count) !== undefined) detail["吸粉量"] = String(num(m.subscribe_count));
    } else {
      id = JSON.parse(node.getAttribute("data-impression") || "{}").noteTarget?.value?.noteId;
      title = node.querySelector(".note-card__title")?.innerText.trim();
      published =
        node.innerText.match(/\d{4}[-/]\d{2}[-/]\d{2}(?:\s+\d{2}:\d{2})?/)?.[0].replaceAll("/", "-") || "";
      const n = [...node.querySelectorAll(".note-card__stat")].map((e) => num(e.innerText));
      if (n.length !== 5) throw new Error("小红书作品指标栏已变化");
      counts = clean({ views: n[0], comments: n[1], likes: n[2], favorites: n[3], shares: n[4] });
    }
    if (!id) throw new Error("作品列表缺少稳定 ID");
    posts.push({ id: String(id), title: String(title || "无标题作品").trim(), published, counts, detail });
  }
  let total = null,
    finished = false;
  if (platform === "xhs") {
    const foot = [...document.querySelectorAll(".bottom-loading")].find(
      (e) => e.getClientRects().length && /共\s*\d+\s*篇笔记|没有更多/.test(e.innerText)
    );
    const upper = num(document.querySelector(".tab-list")?.innerText.match(/全部\s*([\d,]+)/)?.[1]);
    finished = !!foot || (all.length > 0 && all.length === upper) || (!all.length && /暂无.*笔记/.test(text));
    if (finished) total = all.length;
  } else {
    const count = num(text.match(/作品\s*[(（](\d+)[)）]/)?.[1]);
    finished = /没有更多作品|暂无作品/.test(text) || (count !== undefined && all.length === count);
    if (finished) total = all.filter(douyinStatus).length;
  }
  return { posts, size: all.length, rawSize: visible.length, total, finished };
}
async function cardBatch(page, platform, cursor, expectedId) {
  const { offset, anchor } = cursor;
  await go(page, homes[platform]);
  const selector = lists[platform];
  if (platform === "xhs") {
    const tab = ".tab-list .tab-item";
    await ensureReady(
      page,
      (s) => [...document.querySelectorAll(s)].some((e) => e.textContent.trim() === "已发布"),
      tab
    );
    const active = await page.evaluate(
      (s) =>
        [...document.querySelectorAll(s)]
          .find((e) => e.textContent.trim() === "已发布")
          ?.className.includes("active"),
      tab
    );
    if (!active) await page.click("css=" + tab + ':text-is("已发布")', { label: "读取已发布作品" });
  }
  await ensureReady(
    page,
    ({ selector, platform }) => {
      if (document.querySelector(selector)) return true;
      const body = document.body?.innerText || "";
      return /暂无.*(?:作品|笔记)|还没有.*(?:作品|笔记)/.test(body);
    },
    { selector, platform }
  );
  const account = await identity(page, platform, expectedId);
  const start = anchor ? Math.max(0, offset - 1) : offset;
  let list = await page.evaluate(readCards, { platform, offset: start, selector });
  let stalled = 0;
  while (list.size <= offset && !list.finished) {
    const before = list.size;
    const point = await page.evaluate(async (s) => {
      let n = document.querySelector(s);
      while (
        n &&
        !(n.scrollHeight > n.clientHeight + 4 && /(auto|scroll)/.test(getComputedStyle(n).overflowY))
      )
        n = n.parentElement;
      n = n || document.scrollingElement;
      const r = n.getBoundingClientRect();
      n.scrollTo(0, Math.max(0, n.scrollHeight - n.clientHeight - n.clientHeight));
      // Allow the list's intersection observer to leave the footer before re-entering it.
      await new Promise((resolve) => setTimeout(resolve, 450));
      n.scrollTo(0, n.scrollHeight);
      return [
        Math.max(1, Math.min(innerWidth - 2, r.x + r.width / 2)),
        Math.max(1, Math.min(innerHeight - 2, r.y + r.height / 2)),
      ];
    }, selector);
    const changed = ({ s, n }) =>
      [...document.querySelectorAll(s)].filter((e) => e.getClientRects().length).length > n ||
      [...document.querySelectorAll(".bottom-loading")].some(
        (e) => e.getClientRects().length && /共\s*\d+\s*篇笔记|没有更多/.test(e.innerText)
      ) ||
      /没有更多作品/.test(document.body?.innerText || "");
    const watch = { s: selector, n: list.rawSize };
    try {
      await page.waitForFunction(changed, watch, { timeout: 3500 });
    } catch {
      const latest = await page.evaluate(readCards, { platform, offset: start, selector });
      if (latest.size === before && !latest.finished) {
        await page.mouse.move(...point, { label: "定位作品列表" });
        await page.mouse.wheel(0, -780);
        await new Promise((resolve) => setTimeout(resolve, 450));
        await page.mouse.wheel(0, 1400);
        await ensureReady(page, changed, watch);
      }
    }
    list = await page.evaluate(readCards, { platform, offset: start, selector });
    stalled = list.size === before ? stalled + 1 : 0;
    if (stalled >= 3 && !list.finished) throw new Error("后台分页未前进，已保留导入进度");
  }
  if ((list.finished && list.size < offset) || (anchor && list.posts.shift()?.id !== anchor))
    return { ...account, restart: true, next: null };
  return {
    ...account,
    posts: list.posts,
    inventory: list.total ?? undefined,
    coverage: "后台已发布作品",
    next: list.finished
      ? { phase: platform === "xhs" ? "deep" : "fans", offset: 0 }
      : { phase: "list", offset: list.size, anchor: platform === "xhs" ? list.posts.at(-1)?.id : undefined },
  };
}
async function biliBatch(page, offset, expectedId) {
  await go(page, homes.bilibili);
  const account = await identity(page, "bilibili", expectedId);
  const result = await page.evaluate(
    async (pn) => {
      const r = await (await fetch("/x/web/archives?status=pubed&pn=" + pn + "&ps=50&coop=1")).json();
      if (r.code !== 0 || !Array.isArray(r.data?.arc_audits) || !Number.isInteger(r.data?.page?.count))
        throw new Error("B 站稿件列表不可用");
      const posts = r.data.arc_audits.map(({ Archive: a, stat: s }) => {
        const counts = Object.fromEntries(
          Object.entries({
            views: s?.view,
            likes: s?.like,
            comments: s?.reply,
            favorites: s?.favorite,
            shares: s?.share,
          }).filter(([, v]) => Number.isFinite(v))
        );
        const detail = {};
        if (s?.coin != null) detail["投币"] = String(s.coin);
        if (s?.danmaku != null) detail["弹幕"] = String(s.danmaku);
        const d = new Date((a.ptime || a.ctime) * 1000);
        return {
          id: a.bvid,
          title: a.title,
          published:
            d.toLocaleDateString("sv-SE", { timeZone: "Asia/Shanghai" }) +
            " " +
            d.toLocaleTimeString("en-GB", { timeZone: "Asia/Shanghai" }),
          counts,
          detail,
        };
      });
      return { posts, total: r.data.page.count, owner: r.data.arc_audits[0]?.Archive?.mid };
    },
    Math.floor(offset / 50) + 1
  );
  if (result.owner && String(result.owner) !== account.id) throw new Error("B 站登录账号发生变化");
  const end = offset + result.posts.length;
  if (end < result.total && !result.posts.length) throw new Error("B 站分页中断");
  return {
    ...account,
    posts: result.posts,
    inventory: result.total,
    coverage: "后台已发布稿件（含仅自己可见）",
    next: end >= result.total ? { phase: "fans", offset: 0 } : { phase: "list", offset: end, total: result.total },
  };
}
// The creator's “全部” preset covers 365 days. Use its published-works filter and
// native date search to enumerate older windows, including gaps with no uploads.
async function ksHistory(page, cursor, day, expectedId) {
  await go(page, homes.kuaishou);
  await ensureReady(page, () =>
    [...document.querySelectorAll(".el-tabs__item")].some((e) => e.innerText === "已发布")
  );
  if (
    !(await page.evaluate(() =>
      [...document.querySelectorAll(".el-tabs__item.is-active")].some((e) => e.innerText === "已发布")
    ))
  )
    await page.click('css=.el-tabs__item:text-is("已发布")', { label: "读取已发布作品" });
  const account = await identity(page, "kuaishou", expectedId);
  let window = cursor.window || 0,
    offset = cursor.offset,
    total = cursor.previous || 0,
    anchor = cursor.anchor;
  for (let attempt = 0; ; attempt++) {
    const result = await page.evaluate(
      async ({ window, offset, day, anchor }) => {
        let c;
        for (const el of document.querySelectorAll(
          ".el-tabs,.el-range-editor,.main-container-infinite-list"
        )) {
          for (let v = el.__vue__; v; v = v.$parent)
            if (v.$options?.name === "works-manage") {
              c = v;
              break;
            }
          if (c) break;
        }
        if (!c || String(c.curListStatus) !== "1") throw new Error("快手作品筛选未就绪");
        const interval = 86400000,
          end = Date.parse(day + "T00:00:00+08:00") + (1 - window * 365) * interval - 1;
        // Use the lower bound exposed by the date picker, so quiet years do not stop an import.
        const selectable = document.querySelector(".el-range-editor")?.__vue__?.pickerOptions?.disabledDate;
        if (typeof selectable !== "function") throw new Error("快手历史日期范围不可读");
        let low = -100000,
          high = Math.floor((Date.parse(day) - interval) / interval);
        while (high - low > 1) {
          const mid = Math.floor((low + high) / 2);
          if (selectable(new Date(mid * interval))) low = mid;
          else high = mid;
        }
        const floor = high * interval - 28800000,
          start = Math.max(floor, end + 1 - 365 * interval);
        const current = c.filterForm.time;
        if (
          window === 0
            ? current.dateType !== 5
            : current.dateType !== "" || current.startTime !== start || current.endTime !== end
        ) {
          const time = window === 0 ? c.getNearTime(365) : { startTime: start, endTime: end };
          c.onFilterChanged({ time: { ...time, dateType: window === 0 ? 5 : "" } });
        }
        const state = c.fetchListRest;
        for (let i = 0; state.isLoading && i < 130; i++) await new Promise((r) => setTimeout(r, 80));
        if (state.isLoading || (!state.list.length && state.nextCursor !== "no_more"))
          throw new Error("快手未返回历史区间，请稍后重试");
        while (state.list.length <= offset && state.nextCursor !== "no_more") {
          const before = state.list.length;
          await c.fetchVideoList();
          if (state.list.length === before && state.nextCursor !== "no_more")
            throw new Error("快手历史分页未前进");
        }
        if (anchor && state.list[offset - 1]?.workId !== anchor) return { restart: true };
        const posts = state.list.slice(offset).map((v) => {
          const d = new Date(Number(v.uploadTime));
          const fmt = { timeZone: "Asia/Shanghai" };
          const counts = Object.fromEntries(
            Object.entries({ views: v.playCount, likes: v.likeCount, comments: v.commentCount }).filter(
              ([, n]) => Number.isFinite(n)
            )
          );
          return {
            id: v.workId,
            title: v.title || "无标题作品",
            published: d.toLocaleDateString("sv-SE", fmt) + " " + d.toLocaleTimeString("en-GB", fmt),
            counts,
            detail: {},
          };
        });
        const done = state.nextCursor === "no_more";
        if (done && state.list.length !== state.total) throw new Error("快手列表数量与该区间后台总数不一致");
        return {
          posts,
          size: state.list.length,
          total: state.total,
          done,
          earliest: start === floor,
          last: state.list.at(-1)?.workId,
        };
      },
      { window, offset, day, anchor }
    );
    if (result.restart) return { ...account, restart: true, next: null };
    if (!result.done)
      return {
        ...account,
        posts: result.posts,
        next: { phase: "list", window, offset: result.size, total: result.total, previous: total, anchor: result.last },
      };
    total += result.total;
    const next = result.earliest
      ? { phase: "deep", offset: 0 }
      : { phase: "list", window: window + 1, offset: 0, previous: total };
    if (result.posts.length || result.earliest || attempt >= 5)
      return {
        ...account,
        posts: result.posts,
        inventory: result.earliest ? total : undefined,
        coverage: "已发布作品按可选日期逐年导入。深度指标覆盖近 90 天公开作品",
        next,
      };
    window++;
    offset = 0;
    anchor = undefined;
  }
}
async function xhsDeep(page, offset, day, expectedId) {
  await go(page, "https://creator.xiaohongshu.com/statistics/data-analysis");
  await ensureReady(
    page,
    () =>
      document.body?.innerText.includes("笔记首发时间") &&
      /共\s*\d+\s*条|暂无数据|暂无笔记/.test(document.body.innerText)
  );
  const account = await identity(page, "xhs", expectedId);
  const result = await page.evaluate(
    async ({ offset, day }) => {
      function controls() {
        const root = document.querySelector("#app")?.__vue_app__?._container?._vnode?.component;
        const seen = new Set(),
          result = {};
        function visit(n) {
          if (!n || seen.has(n)) return;
          seen.add(n);
          const c = n.component,
            p = n.props || {},
            name = c?.type?.name || c?.type?.__name;
          if (name === "DateRangePicker" && p.modelValue?.end) result.dates = p;
          if (name === "BaseTable" && Array.isArray(p["data-source"])) result.rows = p["data-source"];
          if (c) visit(c.subTree);
          if (Array.isArray(n.children))
            for (const child of n.children) if (typeof child === "object") visit(child);
          if (n.suspense) visit(n.suspense.activeBranch);
        }
        visit(root?.subTree);
        return result;
      }
      // Wait for the normal creator-page read associated with a date or page selection.
      async function change(action) {
        const loaded = new Promise((resolve) => {
          const obs = new PerformanceObserver((list) => {
            if (list.getEntries().some((e) => new URL(e.name).pathname.endsWith("/note/analyze/list"))) {
              clearTimeout(timer);
              obs.disconnect();
              resolve(true);
            }
          });
          const timer = setTimeout(() => {
            obs.disconnect();
            resolve(false);
          }, 6500);
          obs.observe({ entryTypes: ["resource"] });
        });
        action();
        if (!(await loaded)) throw new Error("小红书内容分析未完成加载");
        await new Promise((r) => setTimeout(r, 100));
      }
      const range = controls().dates;
      if (!range || typeof range["date-disabled"] !== "function")
        throw new Error("小红书内容分析日期筛选不可用");
      const end = range.modelValue.end > day ? day : range.modelValue.end;
      let start = end;
      for (let n = 180; n > 0; n--) {
        const candidate = new Date(Date.parse(end) - 86400000 * n).toISOString().slice(0, 10);
        if (!range["date-disabled"](candidate)) {
          start = candidate;
          break;
        }
      }
      if (range.modelValue.start !== start || range.modelValue.end !== end) {
        const value = { start, end };
        await change(() => {
          range["onUpdate:modelValue"](value);
          range.onChange(value);
        });
      }
      const readPager = () => {
        const el = document.querySelector(".d-pagination");
        const text = el?.innerText.match(/共\s*([\d,]+)\s*条[，,]\s*(\d+)\s*页/);
        const active = el?.querySelector(".d-pagination-page.--color-primary");
        return {
          el,
          page: Number(active?.querySelector(".d-pagination-page-content")?.textContent || 1),
          pages: text ? Number(text[2]) : null,
        };
      };
      let pager = readPager();
      while (pager.page < offset + 1) {
        const next = [...pager.el.querySelectorAll(".d-pagination-page")].at(-1);
        if (!next || next.classList.contains("disabled")) throw new Error("小红书深度数据分页已变动");
        await change(() => next.click());
        const old = pager.page;
        pager = readPager();
        if (pager.page <= old) throw new Error("小红书深度数据分页未前进");
      }
      const rows = controls().rows;
      if (
        !Array.isArray(rows) ||
        (rows.length && !rows.every((r) => r?.id && (r.title || r.readCount != null || r.impCount != null))) ||
        (!rows.length && !/暂无|共\s*0\s*条/.test(document.body.innerText))
      )
        throw new Error("小红书内容分析未返回可核对的行");
      if (rows.length && pager.pages === null) throw new Error("小红书内容分析缺少总页数");
      return {
        enrich: rows.map((r) => {
          const detail = {};
          if (r.impCount != null) detail["曝光"] = String(r.impCount);
          if (r.coverClickRate != null)
            detail["封面点击率"] = Number((r.coverClickRate * 100).toFixed(2)) + "%";
          if (r.viewTimeAvg != null) detail["人均观看时长"] = r.viewTimeAvg + " 秒";
          if (r.increaseFansCount != null) detail["涨粉"] = String(r.increaseFansCount);
          if (r.danmakuCount != null) detail["弹幕"] = String(r.danmakuCount);
          return { id: String(r.id), counts: {}, detail };
        }),
        pages: pager.pages,
        more: pager.page < (pager.pages || 0),
        coverage: "后台已发布笔记。深度指标覆盖 " + start + " 至 " + end + " 的可分析笔记",
      };
    },
    { offset, day }
  );
  return {
    ...account,
    enrich: result.enrich,
    coverage: result.coverage,
    next: result.more ? { phase: "deep", offset: offset + 1, total: result.pages } : { phase: "fans", offset: 0 },
  };
}
async function ksDeep(page, offset, expectedId) {
  await go(page, ksAnalysis);
  await ensureReady(page, () => {
    const c = document.querySelector(".statistics_article_list")?.__vue__;
    return c && (c.list?.length || c.empty || /暂无.*作品|暂无数据/.test(c.$el.innerText));
  });
  const account = await identity(page, "kuaishou", expectedId);
  const pn = offset + 1;
  while ((await page.evaluate(() => document.querySelector(".statistics_article_list").__vue__.page)) < pn) {
    const before = await page.evaluate(
      () => document.querySelector(".statistics_article_list").__vue__.list[0]?.photoId
    );
    await page.click(".statistics_article_list .btn-next", { label: "读取下一页作品分析" });
    await ensureReady(
      page,
      (id) => document.querySelector(".statistics_article_list").__vue__.list[0]?.photoId !== id,
      before
    );
  }
  const rows = await page.evaluate(() => {
    const c = document.querySelector(".statistics_article_list").__vue__;
    const enrich = c.list.map((v) => {
      const detail = {};
      if (v.fpr != null && Number.isFinite(+v.fpr))
        detail["完播率"] = Number((+v.fpr * 100).toFixed(2)) + "%";
      if (v.followCount != null) detail["涨粉量"] = String(v.followCount);
      const counts = {};
      if (v.collectCount != null) counts.favorites = Number(v.collectCount);
      return { id: String(v.photoId), counts, detail };
    });
    return { enrich, more: c.page * c.count < c.total, pages: c.count > 0 ? Math.ceil(c.total / c.count) : undefined };
  });
  return {
    ...account,
    enrich: rows.enrich,
    next: rows.more ? { phase: "deep", offset: pn, total: rows.pages } : { phase: "fans", offset: 0 },
  };
}
async function fanBatch(page, platform, day, expectedId) {
  await go(page, fansPages[platform]);
  await ensureReady(page, () => !!document.body?.innerText.trim());
  if (platform === "xhs")
    await ensureReady(
      page,
      () =>
        !!document.querySelector("#app")?.__vue_app__?.config.globalProperties.$store.state.Auth.userInfo
          ?.userId
    );
  const account = await identity(page, platform, expectedId);
  const fans = await page.evaluate(
    async ({ platform, day, total }) => {
      const dayOf = (t) => new Date(t).toLocaleDateString("sv-SE", { timeZone: "Asia/Shanghai" });
      if (platform === "xhs") {
        const f = (await (await fetch("/api/galaxy/creator/data/fans/overall_new")).json()).data?.thirty;
        if (f?.fans_count == null) throw new Error("小红书粉丝统计暂不可用");
        const byDate = (a) => new Map((a || []).map((i) => [i.date, i.count]));
        const gains = byDate(f.rise_fans_list),
          losses = byDate(f.leave_fans_list);
        return [
          ...(f.fans_list || []).map((v) => {
            const gain = gains.get(v.date),
              loss = losses.get(v.date);
            return {
              day: dayOf(v.date),
              total: v.count,
              gain,
              loss,
              net: gain != null && loss != null ? gain - loss : undefined,
            };
          }),
          { day, total: f.fans_count },
        ];
      }
      if (platform === "bilibili") {
        const f = (await (await fetch("/x/web/index/stat")).json()).data;
        if (f?.total_fans == null) throw new Error("B 站粉丝统计暂不可用");
        const h = await fetch("/x/web/data/v2/overview/stat/graph?period=2&s_locale=zh_CN&type=fan")
          .then((r) => r.json())
          .catch(() => null);
        const history = (h?.data?.tendency || [])
          .map((v) => ({ day: dayOf(v.date_key * 1000), net: v.total_inc }))
          .filter((v) => v.day < day);
        return [...history, { day, total: f.total_fans, net: f.incr_fans }];
      }
      if (!Number.isFinite(total)) throw new Error("未读到账号粉丝总数");
      return [{ day, total }];
    },
    { platform, day, total: account.total }
  );
  return { ...account, fans, next: null };
}
function readBatch(page, {platform, day, cursor, accountId}) {
  if (cursor.phase === "fans") return fanBatch(page, platform, day, accountId);
  if (cursor.phase === "deep")
    return platform === "xhs" ? xhsDeep(page, cursor.offset, day, accountId) : ksDeep(page, cursor.offset, accountId);
  if (platform === "kuaishou") return ksHistory(page, cursor, day, accountId);
  return platform === "bilibili" ? biliBatch(page, cursor.offset, accountId) : cardBatch(page, platform, cursor, accountId);
}
async function mediaStep(job) {
  if (job.profiles) {
    return (await profiles())
      .filter(item => typeof item.id === "string" && item.id.length > 0)
      .map(item => ({ id: item.id, name: item.name || item.displayName || item.id }));
  }
  if (job.close) {
    const entry = (await listTaskSpaces()).find((s) => s.name === job.space);
    if (entry?.ownership === "agent") {
      const existing = await taskSpace(entry.id);
      await existing.finish({ keep: [] });
    }
    return { closed: true };
  }
  if (!Object.hasOwn(homes, job.platform) || !job.profileId) {
    throw new Error("Choose a creator platform and an Ego Lite profile first.");
  }
  const existing = (await listTaskSpaces()).find(s => s.name === job.space);
  if (existing && existing.ownership !== "agent") throw new Error("同步页已交由用户控制，请稍后重试");
  if (existing ? existing.profileId !== job.profileId : !(await profiles()).some(p => p.id === job.profileId))
    throw new Error("The selected Ego Lite profile is unavailable.");
  const task = existing ? await taskSpace(existing.id) :
    await taskSpace(job.space, {profileId: job.profileId});
  const page = (await task.pages())[0];
  if (!page) throw new Error("Ego Lite 任务页不可用");
  if (job.identify) {
    await go(page, homes[job.platform]);
    await ensureReady(page, p => {
      if (!document.body?.innerText.trim()) return false;
      if (p !== "xhs") return true;
      return Boolean(document.querySelector("#app")?.__vue_app__?.config.globalProperties.$store.state.Auth?.userInfo?.userId);
    }, job.platform);
    const { id, name } = await identity(page, job.platform);
    return { id, name };
  }
  if (!job.accountId) throw new Error("Confirm the creator account before syncing.");
  if (job.reload && await page.url() !== "about:blank")
    await page.reload({waitUntil:"commit", timeout:25000});
  const batch = await readBatch(page, job);
  if (job.accountId) await identity(page, job.platform, job.accountId);
  return batch;
}
